  (dolist (case `(("src/app.el" 2 "/tmp/project/src/app.el")
                  ("/tmp/report.el" 3 "/tmp/report.el")
                  ("~/report.el" 2 ,(expand-file-name "~/report.el"))
                  ("'reports/a b.el'" 5 "/tmp/project/reports/a b.el")
                  ("./-danger.el" 3 "/tmp/project/-danger.el")))
