      (pilish--handle-display-event
       '(:type "message_end" :message (:role "assistant")))
      (pilish--handle-display-event
       '(:type "tool_execution_start" :toolCallId "call_1"
         :toolName "write"
         :args (:path "/tmp/preview.py" :content "line1\nline2\n")))
