     '(:type "tool_execution_update"
       :toolCallId "c1"
       :partialResult
       (:content [(:type "text"
                   :text "# Heading\necho \"**bold**\"\necho \"__init__.py\"\n")])))
    (pilish-test--flush-tool-updates)
    ;; Simulate jit-lock
